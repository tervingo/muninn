# --- Base de datos (Neon / Postgres) ---
# Cadena de conexión completa. En Neon usar la variante "pooled" con sslmode=require.
DATABASE_URL=postgres://usuario:password@host/dbname?sslmode=require

# --- Servidor ---
PORT=3000
# Origen del frontend, para CORS. En producción: https://tu-app.netlify.app
FRONTEND_URL=http://localhost:5173

# --- Autenticación WebAuthn (SimpleWebAuthn) ---
# RP ID = dominio SIN protocolo ni puerto. En local: localhost
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Muninn
# Origen COMPLETO desde el que se sirve el frontend (con protocolo y puerto).
WEBAUTHN_ORIGIN=http://localhost:5173

# Secreto para firmar las cookies de sesión/challenge (JWT). Generar uno aleatorio largo.
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Cookies "Secure" (requiere HTTPS). true en producción, false en local http.
COOKIE_SECURE=false

# --- Almacenamiento multimedia (Cloudflare R2, fase 3) ---
R2_ACCOUNT_ID=tu-account-id-de-cloudflare
R2_ACCESS_KEY_ID=tu-access-key-id
R2_SECRET_ACCESS_KEY=tu-secret-access-key
R2_BUCKET_NAME=muninn
# Opcional: por defecto se deriva de R2_ACCOUNT_ID.
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# --- Búsqueda semántica (Voyage AI, fase 6) ---
VOYAGE_API_KEY=tu-api-key-de-voyage
# Opcional: por defecto voyage-4-lite. La dimensión de salida (1024) está fijada
# en el esquema (columna `embedding vector(1024)`); si cambias de modelo o de
# dimensión hay que migrar la columna también.
# VOYAGE_MODEL=voyage-4-lite
