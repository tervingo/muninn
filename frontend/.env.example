# URL base del backend (API REST). En local apunta al servidor Express.
# En producción: https://muninn-backend.onrender.com
VITE_API_URL=http://localhost:3000

# App key del Dropbox Chooser (botón 📎 "Adjuntar documento de Dropbox" en el editor).
# No es secreta: se expone en el cliente por diseño de Dropbox. Se consigue creando una
# app en https://www.dropbox.com/developers/apps (tipo "Scoped access" o similar; el
# Chooser no necesita OAuth, solo la app key). Sin esta variable el botón queda deshabilitado.
VITE_DROPBOX_APP_KEY=
